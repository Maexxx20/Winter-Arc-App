{
  "expo": {
    "name": "Nordwand",
    "slug": "nordwand",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nordwand",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F3F5F8",
    "ios": {
      "bundleIdentifier": "ch.maxkon.nordwand",
      "supportsTablet": false,
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "ch.maxkon.nordwand",
      "adaptiveIcon": {
        "backgroundColor": "#1E4BC4",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_HYDRATION",
        "android.permission.health.READ_MINDFULNESS"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F5F8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "dark": {
            "backgroundColor": "#0A0E13"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2657D9"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Nordwand braucht Zugriff auf deine Fotos, damit du Bilder zu deinem Tagebuch hinzufügen kannst.",
          "cameraPermission": "Nordwand braucht Zugriff auf die Kamera, damit du Fotos für dein Tagebuch aufnehmen kannst.",
          "microphonePermission": false
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Nordwand liest Schritte, Workouts, Schlaf, Wasser und Achtsamkeitsminuten, um deine Regeln automatisch abzuhaken. Die Werte werden nur gelesen.",
          "NSHealthUpdateUsageDescription": "Nordwand schreibt keine Daten in Apple Health.",
          "background": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "ch.maxkon.nordwand.widgets",
          "groupIdentifier": "group.ch.maxkon.nordwand",
          "widgets": [
            {
              "name": "Nordwand",
              "displayName": "Nordwand",
              "description": "Tag im Arc, Streak und deine Regeln für heute – direkt abhaken.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              }
            }
          ]
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "de",
            "en",
            "fr",
            "it"
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Nordwand",
              "label": "Nordwand",
              "description": "Tag im Arc, Streak und deine Regeln für heute – direkt abhaken.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9b03a7fd-4a21-43ff-aa7e-b2219f815484"
      }
    },
    "owner": "nordwand",
    "locales": {
      "de": "./locales/de.json",
      "en": "./locales/en.json",
      "fr": "./locales/fr.json",
      "it": "./locales/it.json"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/9b03a7fd-4a21-43ff-aa7e-b2219f815484"
    }
  }
}
