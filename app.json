{
  "expo": {
    "name": "Nordwand",
    "slug": "nordwand",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nordwand",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F3F5F8",
    "ios": {
      "bundleIdentifier": "ch.maxkon.nordwand",
      "supportsTablet": false,
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ch.maxkon.nordwand",
      "adaptiveIcon": {
        "backgroundColor": "#E4EBFC",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F5F8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#0A0E13"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2657D9"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Nordwand braucht Zugriff auf deine Fotos, damit du Bilder zu deinem Tagebuch hinzufügen kannst.",
          "cameraPermission": "Nordwand braucht Zugriff auf die Kamera, damit du Fotos für dein Tagebuch aufnehmen kannst.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
